# Placeholders only. Put real values in Vercel → Project → Settings → Environment
# Variables (or a local, git-ignored .env). Never commit real values.

# --- Database (Neon PostgreSQL) ---
# Pooled connection (host contains "-pooler") used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/osw?sslmode=require&pgbouncer=true&connect_timeout=15
# Direct (non-pooled) connection used only by `prisma migrate deploy`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/osw?sslmode=require&connect_timeout=15

# --- Secrets (generate each with: openssl rand -hex 32) ---
AUTH_SECRET=replace-with-at-least-32-random-characters
QR_SIGNING_SECRET=replace-with-another-32-random-characters

# --- Public URL (final HTTPS origin; used in attendance and certificate QR codes) ---
# NEXT_PUBLIC_APP_URL is baked in at build time: redeploy after changing it.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# Optional runtime override (no rebuild needed) and extra trusted origins.
APP_URL=
ALLOWED_ORIGINS=

# --- Demo controls ---
# true only for the jury/demo database: enables seed, RESET and the demo trigger.
# Never bypasses registration, meeting presence, QR or the 90% rule.
DEMO_MODE=false

# --- Meeting (Jitsi) ---
# Recommended: JaaS (8x8.vc). Free tier, no 5-minute embed limit, JWT moderator.
# JaaS console → API keys: App ID (vpaas-magic-cookie-...), key ID and private key.
JAAS_APP_ID=
JAAS_API_KEY_ID=
# PEM private key; real newlines or \n-escaped are both accepted.
JAAS_PRIVATE_KEY=
# JaaS console → Webhooks: endpoint https://YOUR_DOMAIN/api/jaas-webhook with
# PARTICIPANT_JOINED and PARTICIPANT_LEFT; paste its signing secret here.
JAAS_WEBHOOK_SECRET=
# Optional: static Authorization header value configured on the JaaS webhook.
JAAS_WEBHOOK_AUTHORIZATION=

# Fallback when JaaS is not configured. Public meet.jit.si ends embedded calls
# after 5 minutes and needs a signed-in moderator: demo/testing only.
JITSI_DOMAIN=meet.jit.si
# Self-hosted Jitsi with token authentication (HS256).
JITSI_APP_ID=
JITSI_APP_SECRET=
# Generic signed presence adapter (POST /api/jitsi-webhook), 32+ characters.
JITSI_WEBHOOK_SECRET=

# --- Attendance presence source ---
# webhook: only trusted provider callbacks (JaaS webhook) record presence (production).
# browser: participants' browsers report join/leave, server stamps the time
#          (supervised demo only; configure this if no webhook is set up).
PRESENCE_MODE=webhook
