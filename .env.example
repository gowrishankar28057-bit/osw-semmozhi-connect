DATABASE_URL=postgresql://USER:PASSWORD@HOST/osw?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/osw?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
QR_SIGNING_SECRET=replace-with-another-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
JITSI_DOMAIN=meet.jit.si
# Optional authenticated Jitsi deployment. Browser events alone are not proof against a malicious client.
JITSI_APP_ID=
JITSI_APP_SECRET=
JITSI_WEBHOOK_SECRET=
# webhook requires trusted server join/leave events; browser mode is for supervised demonstrations.
PRESENCE_MODE=webhook
